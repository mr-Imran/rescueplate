# Copy to .env for local use, or set these in your hosting dashboard.
# Never commit real values. Nothing here is required for `npm run dev`.

# PostgreSQL connection string. Local default: the database started by `npm run db`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/rescueplate
# Set to true if your provider requires TLS on the connection (for example an external Render URL).
DATABASE_SSL=false

PORT=3000
NODE_ENV=development

# Demo mode: seeds sample data, shows one-click persona sign-in and enables the /demo console.
# Defaults to on in development and off in production.
DEMO_MODE=true
# Optional: require this code before persona sign-in works (share it privately with judges).
DEMO_ACCESS_CODE=
# Optional: a password for the seeded demo accounts (email: <persona>@rescueplate.demo).
# If empty, the accounts get random passwords and can only be used through persona sign-in.
DEMO_PASSWORD=
# Demo mode restores the sample data after this many minutes with no change made by any user,
# so the feed is never left empty once the seeded food has expired. Accounts that visitors
# registered are kept. Default 120; set 0 to switch it off.
DEMO_AUTO_RESET_MINUTES=120

# Optional: create a real administrator at startup (useful when DEMO_MODE is off).
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_TTL_HOURS=12
