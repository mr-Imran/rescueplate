# Copy to .env on the VPS (same folder as docker-compose.yml). Never commit .env.

# Your domain, pointed at the VPS with an A record.
# No domain? Use the free sslip.io name for your IP, e.g. 203-0-113-10.sslip.io
DOMAIN=

# Database password. Use letters and digits only, e.g. the output of: openssl rand -hex 24
POSTGRES_PASSWORD=

# Demo mode: sample data, one-click persona sign-in and the /demo console (for judging).
DEMO_MODE=true
# Optional: require this code before persona sign-in works. Share it privately with judges.
DEMO_ACCESS_CODE=
