{
  "name": "rescueplate",
  "version": "1.0.0",
  "description": "Real-time network that moves surplus food from kitchens to NGOs before it expires.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -k -n db,api,web -c gray,green,cyan \"npm:db\" \"npm:dev:server\" \"npm:dev:client\"",
    "db": "node scripts/dev-db.mjs",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "vitest run",
    "race": "node scripts/race-test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie": "^2.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "embedded-postgres": "^19.0.0-beta.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
